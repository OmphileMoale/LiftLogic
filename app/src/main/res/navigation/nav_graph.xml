<?xml version="1.0" encoding="utf-8"?>
<!-- Every screen in LiftLogic. MainActivity picks the start screen (Login or Home) at runtime. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- ===================== Authentication ===================== -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.liftlogic.ui.auth.LoginFragment"
        android:label="@string/action_log_in"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.liftlogic.ui.auth.RegisterFragment"
        android:label="@string/title_create_account"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_onboarding"
            app:destination="@id/profileSetupFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Used for onboarding after sign-up AND for "Edit profile" in settings -->
    <fragment
        android:id="@+id/profileSetupFragment"
        android:name="com.example.liftlogic.ui.auth.ProfileSetupFragment"
        android:label="@string/title_profile_setup"
        tools:layout="@layout/fragment_profile_setup">
        <argument
            android:name="onboarding"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_onboarding_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/profileSetupFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ===================== Bottom navigation tabs ===================== -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.liftlogic.ui.home.HomeFragment"
        android:label="@string/tab_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/routinesFragment"
        android:name="com.example.liftlogic.ui.routines.RoutinesFragment"
        android:label="@string/tab_workouts"
        tools:layout="@layout/fragment_routines" />

    <fragment
        android:id="@+id/exerciseLibraryFragment"
        android:name="com.example.liftlogic.ui.exercises.ExerciseListFragment"
        android:label="@string/tab_exercises"
        tools:layout="@layout/fragment_exercise_list">
        <argument
            android:name="pickMode"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/progressFragment"
        android:name="com.example.liftlogic.ui.progress.ProgressFragment"
        android:label="@string/tab_progress"
        tools:layout="@layout/fragment_progress" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.liftlogic.ui.profile.ProfileFragment"
        android:label="@string/tab_profile"
        tools:layout="@layout/fragment_profile" />

    <!-- ===================== Routines ===================== -->
    <fragment
        android:id="@+id/routineDetailFragment"
        android:name="com.example.liftlogic.ui.routines.RoutineDetailFragment"
        android:label="@string/title_routine"
        tools:layout="@layout/fragment_routine_detail">
        <argument
            android:name="routineId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/routineEditorFragment"
        android:name="com.example.liftlogic.ui.routines.RoutineEditorFragment"
        android:label="@string/title_edit_routine"
        tools:layout="@layout/fragment_routine_editor">
        <argument
            android:name="routineId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- ===================== Exercises ===================== -->
    <fragment
        android:id="@+id/exercisePickerFragment"
        android:name="com.example.liftlogic.ui.exercises.ExerciseListFragment"
        android:label="@string/title_add_exercises"
        tools:layout="@layout/fragment_exercise_list">
        <argument
            android:name="pickMode"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/exerciseDetailFragment"
        android:name="com.example.liftlogic.ui.exercises.ExerciseDetailFragment"
        android:label="@string/label_exercise"
        tools:layout="@layout/fragment_exercise_detail">
        <argument
            android:name="exerciseId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/exerciseEditorFragment"
        android:name="com.example.liftlogic.ui.exercises.ExerciseEditorFragment"
        android:label="@string/title_custom_exercise"
        tools:layout="@layout/fragment_exercise_editor">
        <argument
            android:name="exerciseId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/onlineExercisesFragment"
        android:name="com.example.liftlogic.ui.exercises.OnlineExercisesFragment"
        android:label="@string/title_browse_online"
        tools:layout="@layout/fragment_online_exercises" />

    <!-- ===================== Workouts ===================== -->
    <fragment
        android:id="@+id/activeWorkoutFragment"
        android:name="com.example.liftlogic.ui.workout.ActiveWorkoutFragment"
        android:label="@string/title_active_workout"
        tools:layout="@layout/fragment_active_workout">
        <action
            android:id="@+id/action_activeWorkout_to_summary"
            app:destination="@id/workoutSummaryFragment"
            app:popUpTo="@id/activeWorkoutFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/workoutSummaryFragment"
        android:name="com.example.liftlogic.ui.workout.WorkoutSummaryFragment"
        android:label="@string/title_workout_summary"
        tools:layout="@layout/fragment_workout_summary">
        <argument
            android:name="workoutId"
            app:argType="long" />
        <argument
            android:name="badges"
            android:defaultValue="@null"
            app:argType="string[]"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.liftlogic.ui.workout.HistoryFragment"
        android:label="@string/title_history"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/workoutDetailFragment"
        android:name="com.example.liftlogic.ui.workout.WorkoutDetailFragment"
        android:label="@string/title_workout"
        tools:layout="@layout/fragment_workout_detail">
        <argument
            android:name="workoutId"
            app:argType="long" />
    </fragment>

    <!-- ===================== Progress / profile tools ===================== -->
    <fragment
        android:id="@+id/bodyWeightFragment"
        android:name="com.example.liftlogic.ui.progress.BodyWeightFragment"
        android:label="@string/title_body_weight"
        tools:layout="@layout/fragment_body_weight" />

    <fragment
        android:id="@+id/toolsFragment"
        android:name="com.example.liftlogic.ui.profile.ToolsFragment"
        android:label="@string/title_tools"
        tools:layout="@layout/fragment_tools" />

    <!-- ===================== Settings ===================== -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.liftlogic.ui.settings.SettingsFragment"
        android:label="@string/settings_title"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.example.liftlogic.ui.settings.ChangePasswordFragment"
        android:label="@string/settings_change_password"
        tools:layout="@layout/fragment_change_password" />

    <fragment
        android:id="@+id/profilePictureFragment"
        android:name="com.example.liftlogic.ui.settings.ProfilePictureFragment"
        android:label="@string/settings_profile_picture"
        tools:layout="@layout/fragment_profile_picture" />

    <fragment
        android:id="@+id/themeFragment"
        android:name="com.example.liftlogic.ui.settings.ThemeFragment"
        android:label="@string/title_app_theme"
        tools:layout="@layout/fragment_theme" />

    <!-- Log out from anywhere: clear the whole back stack and show Login -->
    <action
        android:id="@+id/action_global_logout"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />
</navigation>
