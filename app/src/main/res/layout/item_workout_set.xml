<?xml version="1.0" encoding="utf-8"?>
<!-- One set: number, previous performance, weight, reps and a "done" tick. Swipe to delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/bg_set_row"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp">

    <TextView
        android:id="@+id/set_number"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.LiftLogic.Title"
        tools:text="1" />

    <TextView
        android:id="@+id/previous"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1.4"
        android:background="?attr/selectableItemBackground"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="60 × 8" />

    <EditText
        android:id="@+id/weight_input"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:importantForAutofill="no"
        android:background="@drawable/bg_set_input"
        android:gravity="center"
        android:imeOptions="actionNext"
        android:inputType="numberDecimal"
        android:maxLength="6"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.LiftLogic.Title"
        tools:hint="60" />

    <EditText
        android:id="@+id/reps_input"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:importantForAutofill="no"
        android:background="@drawable/bg_set_input"
        android:gravity="center"
        android:imeOptions="actionDone"
        android:inputType="number"
        android:maxLength="3"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.LiftLogic.Title"
        tools:hint="8" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/done_check"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/cd_set_done" />
</LinearLayout>
