<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.progress.ProgressFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_progress"
            android:textAppearance="@style/TextAppearance.LiftLogic.Headline" />

        <!-- Overview -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="8dp">

                <include
                    android:id="@+id/metric_workouts"
                    layout="@layout/item_metric" />

                <include
                    android:id="@+id/metric_volume"
                    layout="@layout/item_metric" />

                <include
                    android:id="@+id/metric_month"
                    layout="@layout/item_metric" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Weekly volume -->
        <TextView
            android:id="@+id/weekly_title"
            style="@style/LiftLogic.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_weekly_volume" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="170dp">

            <com.example.liftlogic.ui.charts.BarChartView
                android:id="@+id/weekly_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Body weight -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/LiftLogic.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_body_weight" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/log_weight_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/action_log_weight"
                app:icon="@drawable/ic_add" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/body_weight_card"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/body_weight_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LiftLogic.TitleLarge" />

                <TextView
                    android:id="@+id/body_weight_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.example.liftlogic.ui.charts.LineChartView
                    android:id="@+id/body_weight_chart"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Personal records -->
        <TextView
            style="@style/LiftLogic.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_personal_records" />

        <LinearLayout
            android:id="@+id/records_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/records_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:text="@string/empty_records"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/history_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/action_view_history"
            app:icon="@drawable/ic_history" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
